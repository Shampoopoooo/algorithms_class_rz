def canPartition(nums: list[int]) -> bool:
    total = sum(nums)
    
    # Odd total can never be split equally
    if total % 2 != 0:
        return False
    
    target = total // 2
    # dp[s] = True if sum s is reachable using some subset
    dp = [False] * (target + 1)
    dp[0] = True  # empty subset sums to 0
    
    for num in nums:
        # Traverse right-to-left to avoid using the same item twice
        for s in range(target, num - 1, -1):
            dp[s] = dp[s] or dp[s - num]
    
    return dp[target]
