def findTargetSumWays(nums: list[int], target: int) -> int:
    total = sum(nums)
    
    # sum(P) = (target + total) / 2 must be a non-negative integer
    s = target + total
    if s % 2 != 0 or abs(target) > total:
        return 0
    
    goal = s // 2
    # dp[s] = number of ways to reach sum s
    dp = [0] * (goal + 1)
    dp[0] = 1  # one way to make sum 0: pick nothing
    
    for num in nums:
        for s in range(goal, num - 1, -1):
            dp[s] += dp[s - num]
    
    return dp[goal]
